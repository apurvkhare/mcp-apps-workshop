# Shared Editorial Ink palette for the deck's sequence diagrams.
vars: {
  d2-config: {
    sketch: true
    theme-id: 200
    pad: 24
    theme-overrides: {
      N1: "#f4eee3"
      N2: "#b6a78d"
      N3: "#807156"
      N4: "#574b39"
      N5: "#3d3528"
      N6: "#2a241b"
      N7: "#14110d"
      B1: "#b6a78d"
      B2: "#807156"
      B3: "#574b39"
      B4: "#2a241b"
      B5: "#211d17"
      B6: "#1a1712"
      AA2: "#d9744e"
      AA4: "#3a2117"
      AA5: "#3a2117"
      AB4: "#24301a"
      AB5: "#24301a"
    }
  }
}
style.fill: "#14110d"

classes: {
  actor: {
    style.font-size: 36
    style.font-color: "#fbf7f0"
    style.fill: "#2a241b"
    style.stroke: "#574b39"
  }
  ours: {
    style.font-size: 36
    style.font-color: "#fbf7f0"
    style.fill: "#3a2117"
    style.stroke: "#d9744e"
  }
  msg: {
    style.font-size: 34
    style.font-color: "#f4eee3"
    style.stroke: "#b6a78d"
    style.stroke-width: 2
  }
  key: {
    style.font-size: 35
    style.font-color: "#e9a487"
    style.stroke: "#d9744e"
    style.stroke-width: 4
  }
  group: {
    style.font-size: 22
    style.font-color: "#dcc06a"
    style.fill: "#1a1712"
    style.stroke: "#4d3c1c"
  }
}
