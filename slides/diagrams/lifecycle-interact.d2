...@_style
shape: sequence_diagram

view: "View (iframe)" {class: ours}
host: "Host (chat + model)" {class: actor}
mcp: "Expensify server" {class: ours}

view -> host: "tools/call get_summary   4.1" {class: key}
host -> mcp: "tools/call get_summary, a new id" {class: msg}
mcp -> host: "result" {class: msg}
host -> view: "result" {class: msg}
view -> host: "ui/message: a user turn   4.2" {class: key}
view -> host: "tools/call delete_expense   4.3" {class: key}
host -> mcp: "forwarded; the server checks the id" {class: msg}
view -> host: "ui/update-model-context   4.4" {class: key}
