...@_style
shape: sequence_diagram

client: "Client\n(in the host)" {class: actor}
mcp: "Expensify server" {class: ours}

client -> mcp: "server/discover" {class: key}
mcp -> client: "supportedVersions · capabilities · serverInfo" {class: msg}
any: "then any request, in any order, each with its own _meta" {
  class: group
  client -> mcp: "tools/list" {class: key}
  mcp -> client: "tools, with _meta.ui.resourceUri" {class: msg}
  client -> mcp: "tools/call get_summary" {class: key}
  mcp -> client: "content + structuredContent" {class: msg}
  client -> mcp: "resources/read · prompts/get" {class: key}
  mcp -> client: "contents · messages" {class: msg}
}
mcp.n: "No handshake. No session id.\nAny instance can answer." {class: note}
