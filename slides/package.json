{
  "name": "mcp-apps-workshop-slides",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "slidev export --with-clicks false",
    "wire": "cd .. && npx tsx slides/scripts/capture-wire.ts",
    "diagrams": "for f in diagrams/[!_]*.d2; do d2 \"$f\" \"public/$(basename \"$f\" .d2).svg\"; done"
  },
  "dependencies": {
    "@fontsource/fira-code": "5.2.7",
    "@fontsource/newsreader": "5.2.10",
    "@slidev/cli": "51.8.2",
    "@slidev/theme-default": "0.25.0",
    "@slidev/theme-seriph": "0.25.0",
    "vue": "3.5.38"
  }
}
